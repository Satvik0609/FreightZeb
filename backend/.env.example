# ── Database ──────────────────────────────────────────────────────────────────
# Local:  postgresql://postgres:password@localhost:5432/freightzeb
# Docker: postgresql://freightzeb:freightzeb_secret@postgres:5432/freightzeb
# Cloud:  postgresql://user:pass@host:5432/freightzeb?sslmode=require
DATABASE_URL="postgresql://postgres:password@localhost:5432/freightzeb"

# ── Docker Postgres (only needed for docker-compose) ──────────────────────────
POSTGRES_USER=freightzeb
POSTGRES_PASSWORD=freightzeb_secret
POSTGRES_DB=freightzeb

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
LOG_LEVEL=info

# ── Auth ──────────────────────────────────────────────────────────────────────
# Must be at least 32 characters — generate with: openssl rand -hex 32
JWT_SECRET=a7f8c9d2e3f4a5b6c7d8e9f0a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0
JWT_EXPIRES_IN=7d

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
# Leave blank in dev — emails will be logged to console instead of sending.
#
# Gmail setup:
#   1. Enable 2FA on your Google account
#   2. Go to https://myaccount.google.com/apppasswords
#   3. Generate an App Password for "Mail"
#   4. Use that 16-char password as SMTP_PASS (NOT your real Gmail password)
#
# Example (Gmail):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=yourname@gmail.com
#   SMTP_PASS=abcd efgh ijkl mnop   ← App Password (spaces OK)
#   SMTP_FROM=FreightZen <yourname@gmail.com>
#
# Example (SendGrid):
#   SMTP_HOST=smtp.sendgrid.net
#   SMTP_PORT=587
#   SMTP_USER=apikey
#   SMTP_PASS=SG.xxxxxxxxxxxx       ← SendGrid API key
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@freightzeb.com

# ── ML Service (optional Python microservice) ─────────────────────────────────
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_API_KEY=dev-ml-service-key
ML_TIMEOUT_MS=10000
